{
  "name": "cc",
  "version": "0.0.1",
  "description": "A fast, minimal terminal coding agent (Bun + Ink)",
  "type": "module",
  "bin": {
    "cc": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "cc": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5",
    "ink-spinner": "^5",
    "ink-text-input": "^6",
    "react": "^18"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18",
    "typescript": "^5"
  }
}
